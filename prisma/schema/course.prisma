enum course_status {
  DRAFT
  PUBLISHED
}

enum collaborator_status {
  ACTIVE
  REVOKED
}

model Category {
  id          String   @id @default(uuid())
  name        String
  description String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  courses     Course[]
}

model Course {
  id                       String                    @id @default(uuid())
  title                    String
  description              String
  thumbnail                String
  price                    Decimal
  discount_percent         Int?
  level                    String
  status                   course_status
  created_at               DateTime                  @default(now())
  updated_at               DateTime                  @updatedAt
  instructor_id            String
  instructor               User                      @relation(fields: [instructor_id], references: [id])
  category_id              String
  category                 Category                  @relation(fields: [category_id], references: [id])
  sections                 Chapter[]
  enrollments              Enrollment[]
  wishlist                 Wishlist[]
  payments                 Payment[]
  reviews                  Review[]
  certificates             Certificate[]
  roadmapItems             RoadmapItem[]
  roadmapCreationProposals RoadmapCreationProposal[]
  collaborators            CourseCollaborator[]
  activityLogs             CourseActivityLog[]

  // Course-listing filters always pin status=PUBLISHED, then combine with a
  // sort/filter dimension. Composite [status, X] indexes let Postgres avoid a
  // seq scan on the published-course listing (/courses).
  @@index([status, created_at])
  @@index([status, category_id])
  @@index([status, level])
  @@index([status, price])
}

model CourseCollaborator {
  id                 String              @id @default(uuid())
  course_id          String
  user_id            String
  invited_by         String
  status             collaborator_status @default(ACTIVE)
  can_manage_lessons Boolean             @default(false)
  can_manage_quizzes Boolean             @default(false)
  created_at         DateTime            @default(now())
  revoked_at         DateTime?

  course  Course @relation(fields: [course_id], references: [id], onDelete: Cascade)
  user    User   @relation("CourseCollaboratorUser", fields: [user_id], references: [id], onDelete: Cascade)
  inviter User   @relation("CourseCollaboratorInviter", fields: [invited_by], references: [id], onDelete: Cascade)

  @@unique([course_id, user_id])
  @@index([user_id, status])
  @@index([course_id, status])
}

// Nhật ký thao tác nội dung khóa học — để giáo viên sở hữu giám sát trợ giảng.
// action/entity_type là String tự do (giống Notification.type) để khỏi migrate enum.
model CourseActivityLog {
  id           String   @id @default(uuid())
  course_id    String
  actor_id     String
  action       String // CREATE_CHAPTER | UPDATE_LESSON | AI_GENERATE_QUIZ | ...
  entity_type  String // CHAPTER | LESSON | QUIZ | QUESTION
  entity_id    String?
  entity_title String?
  created_at   DateTime @default(now())

  course Course @relation(fields: [course_id], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [actor_id], references: [id], onDelete: Cascade)

  @@index([course_id, created_at])
  @@index([course_id, actor_id, created_at])
}

model Chapter {
  id        String   @id @default(uuid())
  title     String
  course_id String
  order     Int
  course    Course   @relation(fields: [course_id], references: [id])
  lessons   Lesson[]
}

model Lesson {
  id             String           @id @default(uuid())
  title          String
  order          Int
  content        String?
  video_url      String?
  pdf_url        String?
  pdf_text       String?
  quiz           Quiz[]
  is_free        Boolean          @default(false)
  chapter_id     String
  chapter        Chapter          @relation(fields: [chapter_id], references: [id], onDelete: Cascade)
  lessonProgress LessonProgress[]
  questions      LessonQuestion[]
  notes          LessonNote[]
}

enum payment_status {
  PENDING
  PAID
  CANCELLED
  FAILED
}

model Review {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  course_id  String
  course     Course   @relation(fields: [course_id], references: [id])
  rating     Int
  comment    String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, course_id])
}

model Certificate {
  id             String   @id @default(uuid())
  user_id        String
  user           User     @relation(fields: [user_id], references: [id])
  course_id      String
  course         Course   @relation(fields: [course_id], references: [id])
  issued_at      DateTime @default(now())
  certificate_no String   @unique

  @@unique([user_id, course_id])
}

model Payment {
  id         String         @id @default(uuid())
  user_id    String
  user       User           @relation(fields: [user_id], references: [id])
  course_id  String
  course     Course         @relation(fields: [course_id], references: [id])
  amount     Decimal
  status     payment_status @default(PENDING)
  order_code Int            @unique
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt
}

model VideoTranscript {
  video_key  String   @id
  text       String?
  status     String   @default("processing") // processing | done | failed
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}
