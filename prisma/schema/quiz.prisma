enum question_type {
    MCQ
    TRUE_FALSE
    SHORT_ANSWER
    CODING
    DEBUGGING
    CODE_OUTPUT
}

enum attempt_request_status {
    PENDING
    APPROVED
    REJECTED
}

model Quiz {
    id         String   @id @default(uuid())
    lesson_id  String
    lesson     Lesson   @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
    title        String
    pass_score   Int      @default(70)
    require_pass Boolean  @default(false)
    max_attempts Int?
    time_limit   Int?
    created_at   DateTime @default(now())
    updated_at DateTime @updatedAt
    deleted_at DateTime? @db.Timestamptz(3)

    questions Question[]
    attempts  QuizAttempt[]
    attemptRequests QuizAttemptRequest[]
}

model Question {
    id            String        @id @default(uuid())
    quiz_id       String
    quiz          Quiz          @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
    content       String
    type          question_type
    points        Int           @default(1)
    order         Int
    sample_answer String?
    // SHORT_ANSWER: true = AI chấm ngay khi nộp, false = giáo viên chấm tay
    ai_graded     Boolean       @default(false)
    // Code-question fields (CODING / DEBUGGING / CODE_OUTPUT)
    language      String?       // "python", "javascript", "c", "cpp", "java"
    starter_code  String?       // Code khung, code lỗi hoặc đoạn code cần đọc
    solution_code String?       // Lời giải mẫu (chỉ teacher/admin thấy)

    options   Option[]
    answers   AttemptAnswer[]
    testCases TestCase[]
}

model TestCase {
    id          String   @id @default(uuid())
    question_id String
    question    Question @relation(fields: [question_id], references: [id], onDelete: Cascade)
    input       String   // Input truyền vào stdin
    expected    String   // Output mong đợi (so sánh với stdout)
    is_hidden   Boolean  @default(false) // Hidden test case — sinh viên không thấy
    order       Int
}

model Option {
    id          String   @id @default(uuid())
    question_id String
    question    Question @relation(fields: [question_id], references: [id], onDelete: Cascade)
    content     String
    is_correct  Boolean  @default(false)
    order       Int
}

model QuizAttempt {
    id           String   @id @default(uuid())
    user_id      String
    user         User     @relation(fields: [user_id], references: [id])
    quiz_id      String
    quiz         Quiz     @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
    score        Float?
    is_passed    Boolean?
    submitted_at DateTime @default(now())

    answers AttemptAnswer[]

    @@index([user_id, quiz_id, submitted_at])
}

model QuizAttemptRequest {
    id           String                 @id @default(uuid())
    user_id      String
    quiz_id      String
    status       attempt_request_status @default(PENDING)
    requested_at DateTime               @default(now())
    resolved_at  DateTime?
    resolved_by  String?

    user     User  @relation("QuizAttemptRequestStudent", fields: [user_id], references: [id], onDelete: Cascade)
    quiz     Quiz  @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
    resolver User? @relation("QuizAttemptRequestResolver", fields: [resolved_by], references: [id], onDelete: SetNull)

    @@index([quiz_id, status])
    @@index([user_id, quiz_id, status])
}

model AttemptAnswer {
    id            String      @id @default(uuid())
    attempt_id    String
    attempt       QuizAttempt @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
    question_id   String
    question      Question    @relation(fields: [question_id], references: [id], onDelete: Cascade)
    answer        String
    is_correct    Boolean?
    ai_feedback   String?
    points_earned Float?
    code_output   String?     // Lưu kết quả chạy code (CODING / DEBUGGING)
}
